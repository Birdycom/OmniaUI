---
// File: apps/site/src/layouts/ContentPage.astro
// Renders one content file (src/content/<route>) into a complete page at build time:
// header (+ theme switch) -> sidebar shell or plain page -> footer. No client-side navigation scripts.
import { transform } from "../lib/transform.mjs";
import { leftSidebar, tocSidebar } from "../lib/nav.mjs";
import { VERSION, HEADER_LINKS, PRO_LINK, GITHUB, OMNIACSS_URL, sectionOf, crossLinks, FOOTER_LINKS, COPYRIGHT_YEARS } from "../lib/site.mjs";
import { SITE, SITE_URL, plainText, canonicalUrl, jsonLd, ldScript } from "./seo.mjs";

interface Props { source: string; route: string }
const { source, route } = Astro.props;

const match = source.match(/^<!--oc-page (.*?)-->\r?\n?/);
// The meta must be one line of valid JSON; otherwise the page would silently lose its layout.
if (!match && source.startsWith("<!--oc-page")) throw new Error(`${route}: the oc-page meta must be on the first line (no raw line breaks; use \\n inside strings)`);
const meta = match ? JSON.parse(match[1]) : {};
const raw = match ? source.slice(match[0].length) : source;
const page = transform(raw, route);
// Links to /docs/... and /pages/... in the content go to the OmniaCSS site (base URL: OMNIACSS_URL in lib/site.mjs).
const html = crossLinks(page.html);
const toc = page.toc;
const section = sectionOf(route);
// Every sidebar page on this site uses the UI shell (.ocd-shell).
const isSidebar = meta.layout === "sidebar";
// Search engines and share previews (layouts/seo.mjs): canonical + og:url on the production address, one share image
// per site, JSON-LD. The description is decoded once (Astro escapes the attribute itself: "&lt;details&gt;" in the meta
// becomes <details> in the text, not "<details&amp;gt;"). "robots": "noindex" in the page meta (404 page) drops the
// canonical and the structured data.
const title = plainText(meta.title) || SITE.name;
const description = plainText(meta.description);
const shareDescription = description || SITE.description;
const noindex = /noindex/.test(meta.robots || "");
const canonical = noindex ? null : canonicalUrl(route);
const shareImage = SITE_URL + SITE.image.path;
const structured = noindex ? [] : jsonLd({ route, title, description: shareDescription });

// Utilities: the on-demand site build (only the classes the site uses), made by scripts/sync-site.mjs from
// the vendored OmniaCSS copy. There is no full utility build in public/ (it is 11 MB); in "astro dev" new
// utility classes appear after the next "npm run site:build".
const utilities = "/css/omnia-site.css";
const stylesheets = [utilities, "/css/oc-components.css", "/css/oc-code-syntax.css", "/css/oc-blocks.css", "/css/oc-blocks-pro.css", "/css/oc-layout-module.css", "/css/omnia_site.css", "/css/oc-docs-shell.css", "/fonts/docs/docs-fonts.css", "/css/oc-docs-v2.css"];

// Keep the left menu where it was after navigating (and make sure the active item is visible).
const keepNav = `(() => { const nav = document.currentScript.previousElementSibling; const key = "oc-nav-scroll"; try { const y = sessionStorage.getItem(key); if (y !== null) nav.scrollTop = +y; } catch {} const act = [...nav.querySelectorAll('[data-ocd-active="true"]')].pop(); if (act) { const a = act.getBoundingClientRect(), n = nav.getBoundingClientRect(); if (a.top < n.top || a.bottom > n.bottom) nav.scrollTop += a.top - n.top - n.height / 3; } addEventListener("pagehide", () => { try { sessionStorage.setItem(key, nav.scrollTop); } catch {} }); })();`;
// "On this page": highlight the heading being read. Browsers with :target-current do it in CSS; others get this small fallback.
// The fallback sets .is-active on the .oc-toc-link (same look as :target-current, see packages/ui/src/docs-ui.css).
const spy = `(() => { if (CSS.supports("selector(:target-current)")) return; const links = [...document.querySelectorAll(".oc-toc a[href^='#']")]; const root = document.querySelector(".oc-docs-content, .ocd-content"); if (!links.length || !root) return; const heads = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1)))); let raf = 0; const update = () => { raf = 0; const top = root.getBoundingClientRect().top + 80; let cur = 0; heads.forEach((h, i) => { if (h && h.getBoundingClientRect().top <= top) cur = i; }); if (root.scrollTop + root.clientHeight >= root.scrollHeight - 4) cur = links.length - 1; links.forEach((a, i) => a.classList.toggle("is-active", i === cur)); }; root.addEventListener("scroll", () => { raf ||= requestAnimationFrame(update); }, { passive: true }); update(); })();`;
const github = "M12,2A10,10 0 0,0 2,12C2,16.42 4.87,20.17 8.84,21.5C9.34,21.58 9.5,21.27 9.5,21C9.5,20.77 9.5,20.14 9.5,19.31C6.73,19.91 6.14,17.97 6.14,17.97C5.68,16.81 5.03,16.5 5.03,16.5C4.12,15.88 5.1,15.9 5.1,15.9C6.1,15.97 6.63,16.93 6.63,16.93C7.5,18.45 8.97,18 9.54,17.76C9.63,17.11 9.89,16.67 10.17,16.42C7.95,16.17 5.62,15.31 5.62,11.5C5.62,10.39 6,9.5 6.65,8.79C6.55,8.54 6.2,7.5 6.75,6.15C6.75,6.15 7.59,5.88 9.5,7.17C10.29,6.95 11.15,6.84 12,6.84C12.85,6.84 13.71,6.95 14.5,7.17C16.41,5.88 17.25,6.15 17.25,6.15C17.8,7.5 17.45,8.54 17.35,8.79C18,9.5 18.38,10.39 18.38,11.5C18.38,15.32 16.04,16.16 13.81,16.41C14.17,16.72 14.5,17.33 14.5,18.26C14.5,19.6 14.5,20.68 14.5,21C14.5,21.27 14.66,21.59 15.17,21.5C19.14,20.16 22,16.42 22,12A10,10 0 0,0 12,2Z";
---
<!doctype html>
<html lang="en" class="scrollbar-omnia" data-section={section} data-sister-site={OMNIACSS_URL}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  {noindex && <meta name="robots" content={meta.robots} />}
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content={SITE.docs(route) ? "article" : "website"} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={shareDescription} />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:image" content={shareImage} />
  <meta property="og:image:width" content={String(SITE.image.width)} />
  <meta property="og:image:height" content={String(SITE.image.height)} />
  <meta property="og:image:alt" content={SITE.image.alt} />
  <meta property="og:locale" content="en_US" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={shareDescription} />
  <meta name="twitter:image" content={shareImage} />
  <meta name="twitter:image:alt" content={SITE.image.alt} />
  {structured.map((data) => <script is:inline type="application/ld+json" set:html={ldScript(data)} />)}
  <meta name="generator" content={`OmniaUI ${VERSION}`}>
  <!-- Favicon: SVG for modern browsers, ICO/PNG as fallback (Safari, Google, /favicon.ico). "icon": "pro" in the
       page meta shows the OmniaUI Pro star instead of the OmniaUI puzzle piece. -->
  <link rel="icon" href="/favicon.ico" sizes="48x48">
  <link rel="icon" href={meta.icon === "pro" ? "/favicon-pro.svg" : "/favicon.svg"} type="image/svg+xml">
  <link rel="apple-touch-icon" href={meta.icon === "pro" ? "/apple-touch-icon-pro.png" : "/apple-touch-icon.png"}>
  <link rel="manifest" href="/site.webmanifest">
  {/* The top bar fonts first (also after moving between omniacss.eu and omniaui.eu, which do not share a cache). */}
  <link rel="preload" href="/fonts/docs/instrument-sans-normal-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/docs/bricolage-grotesque-normal-latin.woff2" as="font" type="font/woff2" crossorigin>
  {stylesheets.map((href) => <link rel="stylesheet" href={href}>)}
  <!-- Optional progressive enhancement: only REMEMBERS the choice between pages (localStorage). The switch itself is CSS-only (:has + color-scheme). -->
  <script is:inline>
    // OmniaCSS and OmniaUI are different origins with their own localStorage: links to the sister site carry the choice as ?oc-theme=.
    try { const u = new URL(location.href), q = u.searchParams.get("oc-theme"); if (q) { localStorage.setItem("oc-theme", q); u.searchParams.delete("oc-theme"); history.replaceState(history.state, "", u); } const t = q || localStorage.getItem("oc-theme"); if (t && t !== "system") document.documentElement.dataset.theme = t; } catch {}
    const carryTheme = (e) => { const a = e.target.closest && e.target.closest("a[href]"); const sister = document.documentElement.dataset.sisterSite; if (!a || !sister || a.origin !== new URL(sister).origin) return; try { const t = localStorage.getItem("oc-theme"); if (!t) return; const u = new URL(a.href); u.searchParams.set("oc-theme", t); a.href = u.href; } catch {} };
    addEventListener("click", carryTheme); addEventListener("auxclick", carryTheme);
    addEventListener("change", (e) => { if (e.target.name !== "oc-theme" || !e.target.closest(".ocm-theme")) return; try { localStorage.setItem("oc-theme", e.target.value); } catch {} document.documentElement.dataset.theme = e.target.value === "system" ? "" : e.target.value; syncDemos(); });
    // Theme switches inside demos (app shell, app header …) show the theme the page has now and follow the header switch;
    // a click in a demo still themes only that demo (.oc-theme-scope). A demo themed by a toggle button (data-theme on
    // the scope, set by oc-theme.js) falls back to the page theme when the header switch changes.
    const syncDemos = () => { const t = document.documentElement.dataset.theme || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"); for (const sw of document.querySelectorAll(".oc-theme-scope .oc-theme-switch")) { const r = sw.querySelector('input[value="system"]') || sw.querySelector(`input[value="${t}"]`); if (r) r.checked = true; } for (const scope of document.querySelectorAll(".oc-theme-scope[data-theme]")) delete scope.dataset.theme; for (const b of document.querySelectorAll(".oc-theme-scope [data-oc-theme-toggle]")) b.setAttribute("aria-pressed", t === "dark" ? "true" : "false"); };
    matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => { if (!document.documentElement.dataset.theme) syncDemos(); });
    addEventListener("DOMContentLoaded", () => { const t = document.documentElement.dataset.theme || "system"; const r = document.querySelector(`.ocm-theme input[value="${t}"]`); if (r) r.checked = true; syncDemos(); });
  </script>
  <script is:inline src="/js/oc-docs-v2.js" defer></script>
  <Fragment set:html={(meta.head || []).join("\n")} />
</head>
<body class={meta.bodyClass || undefined}>
  <header class:list={["oc-topbar", { "oc-topbar--fixed": isSidebar }]}>
    {/* Every page has the menu button: docs pages open the left menu with it (from 900px down), pages without a sidebar
        only the site links (.ocd-nav-button--site); from 1200px down the site links open with it on every page. */}
    <input type="checkbox" id="ocd-nav-toggle" class="ocd-nav-toggle" aria-label="Show the menu" />
    <label class:list={["ocd-nav-button", { "ocd-nav-button--site": !isSidebar }]} for="ocd-nav-toggle" title="Menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></label>
    <a class:list={["oc-topbar-brand", { "oc-topbar-brand--pro": meta.icon === "pro" }]} href="/index.html">OmniaUI<span class="oc-badge-version ml-1">v{VERSION}</span></a>
    <nav class="oc-topbar-nav" aria-label="Main">
      <ul class="oc-navmenu oc-navmenu--site">
        {HEADER_LINKS.map((link) => (
          <li><a class="oc-navmenu-link" href={link.href} aria-current={link.id === section ? "page" : undefined}>{link.label}</a></li>
        ))}
        <li><a class="oc-navmenu-link" href={GITHUB} target="_blank" rel="noopener noreferrer" aria-label="GitHub"><svg class="oc-navmenu-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={github}></path></svg></a></li>
      </ul>
    </nav>
    <div class="ocd-topbar-actions">
      <a class="oc-btn oc-btn--sm" href={PRO_LINK.href} aria-current={route === PRO_LINK.route ? "page" : undefined}>{PRO_LINK.label}</a>
      <button type="button" class="ocd-search-trigger" data-ocd-search aria-label="Search components and blocks (Ctrl K)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><span>Search OmniaUI…</span><kbd>Ctrl K</kbd></button>
      <fieldset class="oc-theme-switch ocm-theme" aria-label="Color theme">
        <label><input type="radio" name="oc-theme" value="system" checked> System</label>
        <label><input type="radio" name="oc-theme" value="light"> Light</label>
        <label><input type="radio" name="oc-theme" value="dark"> Dark</label>
      </fieldset>
    </div>
  </header>

  <dialog class="ocd-search-dialog" id="ocd-search" aria-label="Search">
    <div class="ocd-search-field"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><input type="search" placeholder="Search components, blocks and classes" aria-label="Search" role="combobox" aria-controls="ocd-search-results" aria-expanded="true" autocomplete="off" spellcheck="false"><kbd>Esc</kbd></div>
    <ul class="ocd-search-results" id="ocd-search-results" role="listbox" aria-label="Results"></ul>
    <p class="ocd-search-empty" hidden>No results. Try a component such as <code>dialog</code>, a block such as <code>pricing</code> or a class such as <code>oc-btn</code>.</p>
    <p class="ocd-search-foot"><span><kbd>↑</kbd> <kbd>↓</kbd> to move</span><span><kbd>Enter</kbd> to open</span><span><kbd>Esc</kbd> to close</span></p>
  </dialog>

  {isSidebar ? (
    <div class="ocd-shell">
      <aside class="ocd-sidebar-left" set:html={leftSidebar(section, route)} />
      <script is:inline set:html={keepNav} />
      <main class="ocd-content" set:html={html} />
      <aside class="ocd-sidebar-right" set:html={tocSidebar(toc)} />
      {toc.length > 0 && <script is:inline set:html={spy} />}
    </div>
  ) : (
    <Fragment set:html={html} />
  )}

  {/* "footer": "site" in the page meta (the home): the full site footer, drawn by /css/oc-home.css. Same columns and
      order as on omniacss.eu (apps/docs/src/layouts/ContentPage.astro in OmniaCSS); the copyright line is the bar below. */}
  {meta.footer === "site" ? (
    <footer class="oc-site-footer hm-footer">
      <div class="oc-container hm-frame">
        <div class="oc-site-footer__grid">
          <div class="oc-site-footer__about">
            <a class="hm-footer-brand" href="/index.html">OmniaUI</a>
            <p>CSS-first components and blocks on OmniaCSS: native HTML with Vue, React, Blade and Livewire wrappers. Made by Birdycom in Belgium.</p>
            <p><span class="oc-pill">v{VERSION} · MIT + Pro</span></p>
          </div>
          <nav aria-label="OmniaCSS">
            <h2 class="oc-site-footer__title">OmniaCSS</h2>
            <ul class="oc-site-footer__list">
              <li><a href={`${OMNIACSS_URL}/docs/index.html`}>Docs</a></li>
              <li><a href={`${OMNIACSS_URL}/docs/colors/system.html`}>Color system</a></li>
              <li><a href={`${OMNIACSS_URL}/docs/functions/index.html`}>CSS functions</a></li>
              <li><a href={`${OMNIACSS_URL}/docs/editor.html`}>Editor extension</a></li>
              <li><a href={`${OMNIACSS_URL}/docs/ai.html`}>AI assistants (MCP)</a></li>
              <li><a href={`${OMNIACSS_URL}/docs/migrate.html`}>Migrate</a></li>
            </ul>
          </nav>
          <nav aria-label="OmniaUI">
            <h2 class="oc-site-footer__title">OmniaUI</h2>
            <ul class="oc-site-footer__list">
              <li><a href="/index.html">Overview</a></li>
              <li><a href="/ui/components.html">Components</a></li>
              <li><a href="/ui/blocks.html">Blocks</a></li>
              <li><a href="/ui/starter-kits.html">Starter kits</a></li>
              <li><a href="/ui/webicons.html">Webicons</a></li>
            </ul>
          </nav>
          <nav aria-label="Pro">
            <h2 class="oc-site-footer__title">Pro</h2>
            <ul class="oc-site-footer__list">
              <li><a href="/ui/pro.html">OmniaUI Pro</a></li>
              <li><a href={PRO_LINK.href}>Pricing</a></li>
              <li><a href="/legal/pro-license.html">Pro license</a></li>
              <li><a href="/ui/security.html">Security</a></li>
            </ul>
          </nav>
          <nav aria-label="Resources">
            <h2 class="oc-site-footer__title">Resources</h2>
            <ul class="oc-site-footer__list">
              <li><a href="https://github.com/Birdycom/OmniaCSS">GitHub OmniaCSS</a></li>
              <li><a href={GITHUB}>GitHub OmniaUI</a></li>
              <li><a href="https://www.npmjs.com/package/@birdycom/omniacss">npm omniacss</a></li>
              <li><a href="https://www.npmjs.com/package/@birdycom/omniaui">npm omniaui</a></li>
              <li><a href="https://marketplace.visualstudio.com/items?itemName=Birdycom.omniacss-intellisense">VS Code extension</a></li>
            </ul>
          </nav>
          <nav aria-label="Legal">
            <h2 class="oc-site-footer__title">Legal</h2>
            <ul class="oc-site-footer__list">
              <li><a href="/legal/terms.html#license">License (MIT)</a></li>
              <li><a href="https://birdycom.be/en/terms/omniaui-pro">Terms</a></li>
              <li><a href="https://birdycom.be/en/privacy">Privacy</a></li>
              <li><a href="https://birdycom.be/en/cookies">Cookies</a></li>
              <li><a href="mailto:support@omniaui.eu">Contact</a></li>
            </ul>
          </nav>
        </div>
      </div>
    </footer>
  ) : null}

  {/* The one bottom bar of every page, full width and fixed like the header: copyright + version, then the site links
      (lib/site.mjs, same labels and order on both sites). Drawn by .ocd-footer in /css/oc-docs-v2.css. */}
  <footer class="oc-footerbar oc-footerbar--split oc-footerbar--fixed ocd-footer">
    <span class="ocd-footer-copy">© <span class="ocd-footer-years">{COPYRIGHT_YEARS.from}–</span>{COPYRIGHT_YEARS.to} Birdycom · <span class="ocd-footer-name">OmniaUI </span>v{VERSION}<span class="ocd-footer-tag"> — CSS-first components and blocks on OmniaCSS</span></span>
    <ul class="oc-footerbar-links" aria-label="Site links">
      {FOOTER_LINKS.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
    </ul>
  </footer>
</body>
</html>
