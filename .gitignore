node_modules
.vscode

# Windows: 'nul' is a device name; scripts using "> nul" in Git Bash create this file
nul
nul.map

# Generated by the build (npm run build)
apps/site/dist/
apps/site/.astro/
apps/site/src/pages/
packages/*/dist/

# PHP packages: Composer installs (each package also has its own .gitignore).
# Note: vendor/omniacss/ (OmniaCSS build) and vendor/omniaui-pro/ (built Pro CSS + block names, no markup)
# at the repo root are vendored copies and MUST stay committed.
php-packages/*/vendor/
php-packages/*/composer.lock
php-packages/*/.phpunit.cache/

# Local AI-agent rules (internal)
.cursor/
