{
    "name": "birdycom/omniaui-laravel",
    "description": "OmniaUI for Laravel: anonymous Blade components (<x-oc::button>, <x-oc::block.app-shell>), @omniacss asset directive and artisan commands.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "blade",
        "css",
        "omniacss",
        "components",
        "dark-mode"
    ],
    "authors": [
        {
            "name": "Serge Cools (Birdycom)"
        }
    ],
    "homepage": "https://github.com/Birdycom/OmniaUI",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Omniacss\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Omniacss\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Omniacss\\Laravel\\OmniacssServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
