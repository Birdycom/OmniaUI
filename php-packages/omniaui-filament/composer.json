{
    "name": "birdycom/omniaui-filament",
    "description": "OmniaUI for Filament: the panel in OmniaUI colors, OmniaCSS and OmniaUI components in your own pages and widgets, no Tailwind build.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "filament", "omniacss", "omniaui", "admin", "dark-mode"],
    "authors": [{ "name": "Serge Cools (Birdycom)" }],
    "homepage": "https://omniaui.eu",
    "support": {
        "issues": "https://github.com/Birdycom/OmniaUI/issues",
        "source": "https://github.com/Birdycom/OmniaUI/tree/main/php-packages/omniaui-filament"
    },
    "require": {
        "php": "^8.2",
        "birdycom/omniaui-laravel": "^0.12.5",
        "filament/filament": "^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "Omniacss\\Filament\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["Omniacss\\Filament\\OmniaFilamentServiceProvider"]
        }
    },
    "minimum-stability": "stable"
}
