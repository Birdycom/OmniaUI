{
  "name": "@birdycom/omniaui-blocks",
  "version": "0.11.2",
  "description": "OmniaUI blocks: ready-made page sections (hero, features, pricing, stats, CTA, auth, sidebars, dashboards) composed from OmniaCSS utilities and OmniaUI components.",
  "type": "module",
  "license": "MIT",
  "author": "Serge Cools (Birdycom)",
  "homepage": "https://omniaui.eu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Birdycom/OmniaUI.git",
    "directory": "packages/blocks"
  },
  "bugs": {
    "url": "https://github.com/Birdycom/OmniaUI/issues"
  },
  "keywords": [
    "css",
    "blocks",
    "sections",
    "landing-page",
    "omniaui"
  ],
  "exports": {
    ".": "./dist/blocks.css",
    "./min": "./dist/blocks.min.css",
    "./blocks/*": "./blocks/*",
    "./manifest.json": "./manifest.json",
    "./package.json": "./package.json",
    "./pro.json": "./pro.json"
  },
  "style": "./dist/blocks.css",
  "files": [
    "dist",
    "blocks",
    "manifest.json",
    "pro.json",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@birdycom/omniaui": "^0.11.2"
  },
  "unpkg": "./dist/blocks.min.css",
  "jsdelivr": "./dist/blocks.min.css",
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
