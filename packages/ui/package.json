{
  "name": "@birdycom/omniaui",
  "version": "0.12.4",
  "description": "OmniaUI components: CSS-first UI built on native HTML (dialog, popover, details) with light-dark() theming — no JavaScript required. Includes the omniaui CLI (add/list).",
  "type": "module",
  "license": "MIT",
  "author": "Serge Cools (Birdycom)",
  "homepage": "https://omniaui.eu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Birdycom/OmniaUI.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/Birdycom/OmniaUI/issues"
  },
  "keywords": [
    "css",
    "components",
    "dialog",
    "popover",
    "dark-mode",
    "omniaui",
    "omniacss"
  ],
  "exports": {
    ".": "./dist/components.css",
    "./min": "./dist/components.min.css",
    "./showcase.css": "./dist/showcase.css",
    "./snippets/*": "./snippets/*",
    "./data-table.js": "./dist/data-table.js",
    "./carousel.js": "./dist/carousel.js",
    "./manifest.json": "./manifest.json",
    "./package.json": "./package.json"
  },
  "style": "./dist/components.css",
  "files": [
    "dist",
    "snippets",
    "bin",
    "manifest.json",
    "README.md",
    "LICENSE"
  ],
  "unpkg": "./dist/components.min.css",
  "jsdelivr": "./dist/components.min.css",
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "omniaui": "./bin/omniaui.mjs"
  },
  "peerDependencies": {
    "@birdycom/omniacss": "^0.12.4"
  },
  "peerDependenciesMeta": {
    "@birdycom/omniacss": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
