{
  "name": "@birdycom/omniaui-vue",
  "version": "0.12.3",
  "description": "OmniaUI for Vue 3: one single-file component per OmniaUI component and block, rendering the exact markup of the CSS packages.",
  "type": "module",
  "license": "MIT",
  "author": "Serge Cools (Birdycom)",
  "homepage": "https://omniaui.eu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Birdycom/OmniaUI.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/Birdycom/OmniaUI/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "components",
    "css",
    "omniaui"
  ],
  "main": "./dist/omniaui-vue.js",
  "module": "./dist/omniaui-vue.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/omniaui-vue.js"
    },
    "./src/*": "./src/*",
    "./manifest.json": "./manifest.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "manifest.json",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "generate": "node scripts/generate-index.mjs",
    "build": "npm run generate && vite build && vue-tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
